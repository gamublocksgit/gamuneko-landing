---
import { copy, localePaths, languageNames, type Locale } from '../i18n/copy';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<header class="site-header">
  <a class="brand" href={localePaths[lang]} aria-label="Gamu Neko home">
    <img src="/assets/app_icon.webp" alt="" width="38" height="38" />
    <span>Gamu Neko</span>
  </a>
  <nav aria-label="Main navigation">
    <label class="lang-switcher">
      <span class="sr-only">Language</span>
      <select id="lang-select" aria-label="Select language">
        {Object.entries(languageNames).map(([locale, label]) => (
          <option value={localePaths[locale as Locale]} selected={locale === lang}>
            {label}
          </option>
        ))}
      </select>
    </label>
    <a class="nav-button" href="#get-the-app">
      {t.header.cta}
    </a>
  </nav>
</header>

<script>
  const select = document.getElementById('lang-select') as HTMLSelectElement;
  select?.addEventListener('change', () => {
    window.location.href = select.value;
  });
</script>

<style>
  .lang-switcher select {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    background: var(--surface);
    color: var(--text);
    font-weight: 900;
    font-size: 0.9rem;
    cursor: pointer;
    min-height: 44px;
  }
</style>
