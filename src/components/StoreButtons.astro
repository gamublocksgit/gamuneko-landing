---
const appStoreUrl = 'https://apps.apple.com/us/app/gamu-neko-pomodoro-timer/id6759168102';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.gamublocks.gamuneko';
---

<div class="store-buttons" aria-label="Download Gamu Nemu">
  <a href={playStoreUrl} rel="noreferrer noopener" target="_blank" aria-label="Download Gamu Nemu on Google Play">
    <img src="/assets/PlayStoreBadge.png" alt="Get it on Google Play" width="200" height="59" loading="lazy" />
  </a>
  <a href={appStoreUrl} rel="noreferrer noopener" target="_blank" aria-label="Download Gamu Nemu on the App Store">
    <img src="/assets/AppStoreBadge.svg" alt="Download on the App Store" width="180" height="54" loading="lazy" />
  </a>
</div>
